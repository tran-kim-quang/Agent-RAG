# Docker target: NVIDIA GPU with Container Toolkit support

# API Keys
OLLAMA_API_KEY=your_ollama_api_key

# Models
LLM_MODEL_NAME=your_chat_model
VISION_MODEL_NAME=your_vision_model
LLM_MODEL_CHUNKER=your_chunker_model
EMBEDDING_MODEL_NAME=qwen3-embedding:4b
EMBEDDING_DIMENSIONS=2560
SEMANTIC_WINDOW_SIZE=3000
SEMANTIC_WINDOW_OVERLAP=200
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_TOP_N=5
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512

# Ollama endpoints
OLLAMA_BASE_URL=https://ollama.com/v1
VISION_REQUEST_TIMEOUT_SECONDS=30
PDF_MAX_EMBEDDED_IMAGES=12
PDF_MIN_EMBEDDED_IMAGE_BYTES=8192
OLLAMA_LOCAL_URL=http://localhost:11434/v1

# OCR correction runs only in the ingest worker and stays on CPU
MODEL_CORRECTION_BACKEND=local
MODEL_CORRECTION_VIETNAMESE=protonx-models/protonx-legal-tc
MODEL_CORRECTION_DEVICE=cpu
MODEL_CORRECTION_IDLE_SECONDS=300
HF_TOKENS=

# Data source
DATA_SOURCE=th1nhng0/vietnamese-legal-documents

# Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=agent_rag
POSTGRES_USER=agent_rag
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql+psycopg://agent_rag:replace_with_a_long_random_password@localhost:5432/agent_rag

# Redis task queue
REDIS_PASSWORD=replace_with_a_long_random_password
REDIS_URL=redis://:replace_with_a_long_random_password@localhost:6379/0
RETRIEVAL_CACHE_TTL_SECONDS=300
RETRIEVAL_CACHE_MAX_ENTRIES=100
RETRIEVAL_CACHE_SIMILARITY_THRESHOLD=0.93
CHAT_TOKEN_STREAM_TTL_SECONDS=3600
CHAT_TOKEN_STREAM_MAX_EVENTS=10000
CHECKPOINT_POOL_SIZE=5
TASK_MAX_RETRIES=3
STALE_TASK_MINUTES=60
CHAT_WORKER_CONCURRENCY=1
INGEST_WORKER_CONCURRENCY=1
CELERY_VISIBILITY_TIMEOUT_SECONDS=21600

# MinIO object storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=agent-rag
MINIO_ROOT_PASSWORD=replace_with_a_long_random_password
MINIO_BUCKET=agent-rag
MINIO_SECURE=false

# API security
ENVIRONMENT=development
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
ALLOW_FIRST_USER_ADMIN=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=25
